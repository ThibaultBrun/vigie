# Copier en db/.env et renseigner. db/.env est ignoré par git.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://vigie:change-me@127.0.0.1:5433/vigie

# Strava (ingestion serveur-à-serveur des sorties pirogue).
# Le refresh token doit avoir le scope activity:read_all (autorisation unique).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
